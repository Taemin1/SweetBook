# Supabase 프로젝트 정보 (Supabase 대시보드 > Project Settings > API)
# anon(public) key는 브라우저 노출을 전제로 설계된 키이며, 실제 접근 제어는
# Row Level Security(RLS)가 담당합니다. 이 프로젝트는 RLS로 보호되어 있어
# 심사 편의를 위해 값을 그대로 채워 커밋했습니다. (docs/ARCHITECTURE.md 참고)
SUPABASE_URL=https://sormnjxvvgutyujmsehe.supabase.co
SUPABASE_ANON_KEY=sb_publishable_qSkDDyKMNGQNJjBsGa7hkQ_4PIqdCHc

# 호스트에 노출할 포트. 3000번이 이미 사용 중이면 원하는 값으로 바꾸세요.
PORT=3000
